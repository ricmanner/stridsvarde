# Kopiera den här filen till .env för att köra appen lokalt:
#   cp .env.example .env

# Var SQLite-databasen ligger. Relativ sökväg utgår från projektmappen.
DATABASE_PATH=./data/psvi.db

# true  = fyll databasen med en demoorganisation och påhittad historik
# false = tom databas, bara ett admin-konto skapas vid första start
# Sätt ALLTID false i skarp drift.
SEED_DEMO_DATA=true

# Minsta antal soldater som måste ha checkat in innan ett aggregat visas
# för befäl. Skyddar mot att en enskild individs hälsodata kan läsas ut
# ur en liten grupps medelvärde. Tillämpas i databasfrågan, inte i UI:t.
MIN_RESPONDERS=4

# Hemlig sträng som blandas in när inloggningskoder hashas.
# Generera en egen med: openssl rand -hex 32
# Byts den ut slutar alla utdelade koder fungera.
AUTH_PEPPER=generera-en-egen-med-openssl-rand-hex-32

# Hur länge en soldats incheckningar sparas, i dagar.
# Tomt = ingen gallring (standard). Minst 30 dagar; under det blir
# trendvyerna meningslösa eftersom de visar upp till 21 dagar.
#
# GDPR tillåter inte att hälsodata sparas längre än nödvändigt. Siffran är
# inte ett tekniskt beslut — Försvarsmakten är personuppgiftsansvarig och
# deras dataskyddsombud måste ange den. Tills dess är gallringen avstängd,
# eftersom att tyst börja radera hälsodata vore värre än att spara den.
RETENTION_DAYS=

# ── Driftsättning ────────────────────────────────────────────────────────────

# Fjärrdatabas. Sätts BARA i molndrift; lokalt används DATABASE_PATH ovan.
# Måste börja med libsql:// — annars faller appen tillbaka på en lokal fil,
# vilket på en serverlös värd betyder en tom databas per anrop.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# demo  = seedad organisation, kända koder, banner överst. Inga verkliga personer.
# pilot = riktiga soldater. Vägrar starta med demodata eller kända koder.
# Standard är pilot — det säkrare av de två om någon glömmer sätta den.
PSVI_ENVIRONMENT=pilot

# Hemlighet för nattkörningen som flyttar fram demodatan (/api/demo-tidslinje).
# Sätts i Vercel för produktion; Vercel skickar den själv till schemalagda
# anrop. Saknas den är rutten AVSTÄNGD — den faller aldrig öppen.
# Generera en egen med: openssl rand -hex 32
CRON_SECRET=
